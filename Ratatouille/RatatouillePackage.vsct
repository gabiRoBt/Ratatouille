<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<Extern href="stdidcmd.h"/>
	<Extern href="vsshlids.h"/>

	<Commands package="guidRatatouillePackage">

		<Groups>
			<Group guid="guidRatatouillePackageCmdSet" id="MyMenuGroup" priority="0x0600">
				<Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
			</Group>
		</Groups>

		<Buttons>
			<Button guid="guidRatatouillePackageCmdSet" id="CommandIdR" priority="0x0100" type="Button">
				<Parent guid="guidRatatouillePackageCmdSet" id="MyMenuGroup"/>
				<Icon guid="guidImages" id="bmpPic1"/>
				<Strings>
					<ButtonText>Ratatouille</ButtonText>
					<CommandName>Ratatouille.FakeTypingCommand</CommandName>
				</Strings>
			</Button>
			<Button guid="guidRatatouillePackageCmdSet" id="CommandIdP" priority="0x0101" type="Button">
				<Parent guid="guidRatatouillePackageCmdSet" id="MyMenuGroup"/>
				<Strings>
					<ButtonText>Ratatouille — Pause / Resume</ButtonText>
					<CommandName>Ratatouille.PauseResume</CommandName>
				</Strings>
			</Button>
			<Button guid="guidRatatouillePackageCmdSet" id="CommandIdS" priority="0x0102" type="Button">
				<Parent guid="guidRatatouillePackageCmdSet" id="MyMenuGroup"/>
				<Strings>
					<ButtonText>Ratatouille — Stop</ButtonText>
					<CommandName>Ratatouille.Stop</CommandName>
				</Strings>
			</Button>
			<Button guid="guidRatatouillePackageCmdSet" id="CommandIdF" priority="0x0103" type="Button">
				<Parent guid="guidRatatouillePackageCmdSet" id="MyMenuGroup"/>
				<Strings>
					<ButtonText>Ratatouille — Finish</ButtonText>
					<CommandName>Ratatouille.Finish</CommandName>
				</Strings>
			</Button>
		</Buttons>

		<Bitmaps>
			<Bitmap guid="guidImages" href="Resources\FakeTypingCommand.png"
					usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough"/>
		</Bitmaps>

	</Commands>

	<KeyBindings>
		<KeyBinding guid="guidRatatouillePackageCmdSet" id="CommandIdR"
					editor="guidVSStd97"
					key1="R" mod1="Control Alt Shift"
					key2="R"/>
		<KeyBinding guid="guidRatatouillePackageCmdSet" id="CommandIdP"
					editor="guidVSStd97"
					key1="R" mod1="Control Alt Shift"
					key2="P"/>
		<KeyBinding guid="guidRatatouillePackageCmdSet" id="CommandIdS"
					editor="guidVSStd97"
					key1="R" mod1="Control Alt Shift"
					key2="S"/>
		<KeyBinding guid="guidRatatouillePackageCmdSet" id="CommandIdF"
					editor="guidVSStd97"
					key1="R" mod1="Control Alt Shift"
					key2="F"/>
	</KeyBindings>

	<Symbols>
		<GuidSymbol name="guidRatatouillePackage"       value="{cadea9e4-5f8b-4d17-ac60-90e43c1afa4d}"/>
		<GuidSymbol name="guidRatatouillePackageCmdSet" value="{125f8fca-8136-4a7d-be65-39638663d1ee}">
			<IDSymbol name="MyMenuGroup" value="0x1020"/>
			<IDSymbol name="CommandIdR"  value="0x0100"/>
			<IDSymbol name="CommandIdP"  value="0x0101"/>
			<IDSymbol name="CommandIdS"  value="0x0102"/>
			<IDSymbol name="CommandIdF"  value="0x0103"/>
		</GuidSymbol>
		<GuidSymbol name="guidImages" value="{34afecfa-6c06-4a36-8490-685e38196dd5}">
			<IDSymbol name="bmpPic1"             value="1"/>
			<IDSymbol name="bmpPic2"             value="2"/>
			<IDSymbol name="bmpPicSearch"        value="3"/>
			<IDSymbol name="bmpPicX"             value="4"/>
			<IDSymbol name="bmpPicArrows"        value="5"/>
			<IDSymbol name="bmpPicStrikethrough" value="6"/>
		</GuidSymbol>
	</Symbols>

</CommandTable>